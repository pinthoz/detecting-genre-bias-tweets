colnames_count <- table(names(train_combined))
duplicates <- names(colnames_count[colnames_count > 1])
print("Duplicate column names:")
print(duplicates)
# Fix duplicate column names by adding suffixes
if(length(duplicates) > 0) {
for(dup in duplicates) {
# Find indices of duplicate columns
dup_indices <- which(names(train_combined) == dup)
# Rename all but the first occurrence
for(i in 2:length(dup_indices)) {
names(train_combined)[dup_indices[i]] <- paste0(dup, "_", i)
}
}
# Do the same for dev_combined
for(dup in duplicates) {
dup_indices <- which(names(dev_combined) == dup)
for(i in 2:length(dup_indices)) {
names(dev_combined)[dup_indices[i]] <- paste0(dup, "_", i)
}
}
}
