# -------------------------------------------------
# 1.  Gerar e anexar features da Task 4
# -------------------------------------------------
generate_task4_features <- function(df, text_col = "tweet") {
df$contains_whore_and_female <- mapply(function(txt, pdoc)
grepl("whore", txt,  TRUE) & pdoc > 0.30,
df[[text_col]], df$prop_doctorate)
df$contains_hate_women <- grepl("hate", df[[text_col]], TRUE) &
grepl("women", df[[text_col]], TRUE)
df$contains_bitch_and_male <- mapply(function(txt, pdoc)
grepl("bitch", txt, TRUE) & pdoc < 0.20,
df[[text_col]], df$prop_doctorate)
df$contains_rape_and_white <- as.integer(
grepl("rape", df[[text_col]], TRUE) & df$middle_eastern == 0)
df$like_women_context <- as.integer(
grepl("like",   df[[text_col]], TRUE) &
grepl("women",  df[[text_col]], TRUE))
df
}
task4_cols <- c("contains_whore_and_female","contains_hate_women",
"contains_bitch_and_male","contains_rape_and_white",
"like_women_context")
train_grouped <- generate_task4_features(train_grouped)
dev_grouped   <- generate_task4_features(dev_grouped)
train_grouped[task4_cols] <- lapply(train_grouped[task4_cols], as.integer)
dev_grouped  [task4_cols] <- lapply(dev_grouped  [task4_cols], as.integer)
# -------------------------------------------------
# 2.  Conjunto completo de variáveis
# -------------------------------------------------
features_task4 <- c(features, task4_cols)
# -------------------------------------------------
# 3.  Data-sets de modelagem
# -------------------------------------------------
train_mod <- train_grouped %>%
select(tweet, final_label, all_of(features_task4)) %>%
rename(sexist = final_label) %>%
mutate(across(where(is.numeric),
~ ifelse(is.na(.) | is.nan(.) | is.infinite(.), 0, .)))
dev_mod <- dev_grouped %>%
select(tweet, final_label, all_of(features_task4)) %>%
rename(sexist = final_label) %>%
mutate(across(where(is.numeric),
~ ifelse(is.na(.) | is.nan(.) | is.infinite(.), 0, .)))
# -------------------------------------------------
# 4.  SMOTE (balanceamento)
# -------------------------------------------------
sm_rec <- recipe(sexist ~ ., data = select(train_mod, -tweet)) %>%
step_smote(sexist)
sm_prep   <- prep(sm_rec)
train_bal <- bake(sm_prep, new_data = NULL)
# -------------------------------------------------
# 5.  Remover variância zero (evita problemas de scale)
# -------------------------------------------------
nzv_metrics <- caret::nearZeroVar(
select(train_bal, -sexist),
saveMetrics = TRUE
)
# nomes das colunas cuja variância é exatamente zero
zv_names <- rownames(nzv_metrics[nzv_metrics$zeroVar == TRUE, ])
# retirar essas colunas do treino e do dev
train_bal <- select(train_bal, -all_of(zv_names))
dev_mod   <- select(dev_mod,   -all_of(zv_names))
# -------------------------------------------------
# 6.  Escalonar (guardando atributos)
# -------------------------------------------------
mat_train <- scale(select(train_bal, -sexist))
center_v  <- attr(mat_train,"scaled:center")
scale_v   <- attr(mat_train,"scaled:scale")
X_train   <- as.data.frame(mat_train)
y_train   <- factor(train_bal$sexist, levels = c("no","yes"))
X_dev     <- as.data.frame(scale(dev_mod[, colnames(X_train)],
center = center_v, scale = scale_v))
y_dev     <- factor(dev_grouped$final_label, levels = c("no","yes"))
# -------------------------------------------------
# 7.  Controle de CV e grade GBM
# -------------------------------------------------
cv_ctrl <- trainControl(method = "cv", number = 5,
classProbs = TRUE,
summaryFunction = twoClassSummary,
savePredictions = "final")
gbm_grid <- expand.grid(
n.trees           = c(300, 600, 900),
interaction.depth = c(1, 2, 3),   # rasas
shrinkage         = c(0.01, 0.005, 0.001),
n.minobsinnode    = c(20, 30)     # folhas maiores
)
# -------------------------------------------------
# 8.  Treino do GBM
# -------------------------------------------------
cat("\nTreinando GBM (Task 4)…\n")
gbm_task4 <- train(x = X_train, y = y_train,
method = "gbm",
trControl = cv_ctrl,
tuneGrid  = gbm_grid,
metric    = "ROC",
verbose   = FALSE)
cat("\nMelhores hiperparâmetros:\n")
print(gbm_task4$bestTune)
# -------------------------------------------------
# 9.  Avaliação
# -------------------------------------------------
prob_dev <- predict(gbm_task4, newdata = X_dev, type = "prob")[,2]
pred_dev <- factor(ifelse(prob_dev > 0.5,"yes","no"), levels = c("no","yes"))
conf_task4 <- caret::confusionMatrix(pred_dev, y_dev, positive = "yes")
roc_task4  <- pROC::roc(y_dev, prob_dev)
auc_task4  <- pROC::auc(roc_task4)
cv_results_list[["GBM_Task4"]] <- gbm_task4$results
# Se você já tem a função evaluate_model() definida no seu projeto:
results_gbm_task4 <- evaluate_model(
gbm_task4,
X_dev,
y_dev,
model_name = "GBM_Task4",
prob_method = "prob"
)
library(gbm)
