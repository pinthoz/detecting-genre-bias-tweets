n.trees = c(100, 200),
interaction.depth = c(3, 5),
shrinkage = c(0.01, 0.1),
n.minobsinnode = c(10)
)
# Train model with caret for cross-validation
gbm_cv_model <- train(
x = X_train_scaled_df,
y = y_train_final,
method = "gbm",
trControl = cv_control,
tuneGrid = gbm_grid,
metric = "ROC",
verbose = FALSE
)
