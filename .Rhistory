dev_combined$sexist <- factor(dev_aggregated$sexist_binary, levels = c(0, 1), labels = c("non-sexist", "sexist"))
# Check for class imbalance
imbalance_table <- table(train_combined$sexist)
cat("Class distribution in the training set:\n")
print(imbalance_table)
# Handle class imbalance if necessary
