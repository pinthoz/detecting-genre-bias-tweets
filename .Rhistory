set.seed(42)
imbalance_ratio <- min(imbalance_table) / max(imbalance_table)
cat("Class imbalance ratio:", imbalance_ratio, "\n")
if (imbalance_ratio < 0.7) {
# Use ROSE to create a balanced dataset
balanced_train <- ROSE(sexist ~ ., data = train_combined, seed = 42)$data
cat("Applied ROSE to balance the dataset\n")
print(table(balanced_train$sexist))
} else {
balanced_train <- train_combined
cat("Dataset is already sufficiently balanced\n")
}
# Function to evaluate model performance
evaluate_model <- function(true_labels, predicted_probs, predicted_labels, model_name) {
# Calculate metrics
conf_matrix <- confusionMatrix(predicted_labels, true_labels, positive = "sexist")
accuracy <- conf_matrix$overall["Accuracy"]
precision <- conf_matrix$byClass["Precision"]
recall <- conf_matrix$byClass["Recall"]
f1 <- conf_matrix$byClass["F1"]
# ROC curve and AUC
roc_obj <- roc(true_labels, as.numeric(predicted_probs))
auc <- auc(roc_obj)
# Print results
cat("\n===", model_name, "Performance ===\n")
cat("Confusion Matrix:\n")
print(conf_matrix$table)
cat("\nAccuracy:", round(accuracy, 4), "\n")
cat("Precision:", round(precision, 4), "\n")
cat("Recall:", round(recall, 4), "\n")
cat("F1 Score:", round(f1, 4), "\n")
cat("AUC:", round(auc, 4), "\n")
# Return metrics in a data frame
return(data.frame(
Model = model_name,
Accuracy = accuracy,
Precision = precision,
Recall = recall,
F1 = f1,
AUC = auc
))
}
