# Load datasets
train_data <- read.csv("data/EXIST2025_train.csv", stringsAsFactors = FALSE, encoding = "UTF-8")
dev_data <- read.csv("data/EXIST2025_dev_labeled.csv", stringsAsFactors = FALSE, encoding = "UTF-8")
# Examine the structure
str(train_data)
head(train_data)
# Function to aggregate annotations by tweet ID
aggregate_annotations <- function(data) {
# Group by tweet ID and get unique tweets
unique_tweets <- data %>%
group_by(id_EXIST) %>%
summarize(
tweet = first(tweet),
lang = first(lang),
# Calculate majority vote for the label (YES=sexist, NO=non-sexist)
sexist = ifelse(mean(label_task1_1 == "YES") >= 0.5, "YES", "NO")
)
return(unique_tweets)
}
# Create aggregated datasets
train_aggregated <- aggregate_annotations(train_data)
dev_aggregated <- aggregate_annotations(dev_data)
# Convert labels to binary format (1=sexist, 0=non-sexist)
train_aggregated$sexist_binary <- ifelse(train_aggregated$sexist == "YES", 1, 0)
dev_aggregated$sexist_binary <- ifelse(dev_aggregated$sexist == "YES", 1, 0)
# Check for class imbalance
table(train_aggregated$sexist_binary)
# Create a corpus from the tweet text
train_corpus <- corpus(train_aggregated$tweet)
dev_corpus <- corpus(dev_aggregated$tweet)
# IMPORTANT: Add document variables properly to the corpus
docvars(train_corpus, "sexist") <- train_aggregated$sexist_binary
docvars(dev_corpus, "sexist") <- dev_aggregated$sexist_binary
# Verify docvars are properly added
cat("Checking if document variables were properly added:\n")
print(head(docvars(train_corpus)))
# Define preprocessing steps
preprocess_tweets <- function(corpus) {
# Create tokens
tokens <- tokens(corpus,
remove_punct = TRUE,      # Remove punctuation
remove_numbers = TRUE,    # Remove numbers
remove_symbols = TRUE,    # Remove symbols
remove_url = TRUE,        # Remove URLs
split_hyphens = FALSE)
# Lowercase tokens (explicitly to ensure consistency)
tokens <- tokens_tolower(tokens)
# Remove stopwords
tokens <- tokens_remove(tokens, pattern = stopwords("en"))
# Apply stemming
tokens <- tokens_wordstem(tokens, language = "en")
return(tokens)
}
# Process training and development data
train_tokens <- preprocess_tweets(train_corpus)
dev_tokens <- preprocess_tweets(dev_corpus)
# Create a document-feature matrix
train_dfm <- dfm(train_tokens)
dev_dfm <- dfm(dev_tokens)
# Trim features that appear in fewer than 5 documents to reduce dimensionality
train_dfm <- dfm_trim(train_dfm, min_docfreq = 5)
# Create a binary target variable for feature selection
target_factor <- factor(docvars(train_corpus, "sexist"))
# FIX: Split the DFM by target class first, then calculate keyness
# Create separate DFMs for sexist and non-sexist tweets
print("Creating separate DFMs for feature selection...")
sexist_docs <- which(docvars(train_corpus, "sexist") == 1)
non_sexist_docs <- which(docvars(train_corpus, "sexist") == 0)
# Verify we have the right documents
cat("Number of sexist documents:", length(sexist_docs), "\n")
cat("Number of non-sexist documents:", length(non_sexist_docs), "\n")
# Make sure the indices are valid
sexist_docs <- sexist_docs[sexist_docs <= ndoc(train_dfm)]
non_sexist_docs <- non_sexist_docs[non_sexist_docs <= ndoc(train_dfm)]
# Get the DFMs for each class
sexist_dfm <- train_dfm[sexist_docs, ]
non_sexist_dfm <- train_dfm[non_sexist_docs, ]
# Use textstat_keyness with the two DFMs
if (length(sexist_docs) > 0 && length(non_sexist_docs) > 0) {
# Target 1 (sexist) vs. reference 0 (non-sexist)
keyness <- textstat_keyness(
rbind(sexist_dfm, non_sexist_dfm),
target = seq_len(ndoc(sexist_dfm))
)
# Get top features based on keyness score (both positive and negative)
sorted_keyness <- keyness[order(abs(keyness$chi2), decreasing = TRUE), ]
top_features <- head(sorted_keyness$feature, 1000)
} else {
# Fallback method if something goes wrong with the class split
feature_freq <- textstat_frequency(train_dfm)
top_features <- head(feature_freq$feature, 1000)
warning("Using frequency-based feature selection as fallback")
}
# Filter DFMs to keep only top features
train_dfm_filtered <- dfm_select(train_dfm, pattern = top_features)
dev_dfm_filtered <- dfm_match(dev_dfm, features = featnames(train_dfm_filtered))
# Apply TF-IDF weighting to the filtered DFM (for model training)
train_tfidf <- dfm_tfidf(train_dfm_filtered)
dev_tfidf <- dfm_tfidf(dev_dfm_filtered)
# Function to extract sentiment and emotion features
extract_features <- function(texts) {
# Wrap in try-catch to handle potential errors
tryCatch({
# Sentiment analysis using sentimentr
sentiment_scores <- sentiment_by(texts)$ave_sentiment
# Emotion recognition using syuzhet
emotions <- get_nrc_sentiment(texts)
# Combine features
features <- data.frame(
sentiment = sentiment_scores,
anger = emotions$anger,
anticipation = emotions$anticipation,
disgust = emotions$disgust,
fear = emotions$fear,
joy = emotions$joy,
sadness = emotions$sadness,
surprise = emotions$surprise,
trust = emotions$trust,
negative = emotions$negative,
positive = emotions$positive
)
return(features)
}, error = function(e) {
# If there's an error, return a simplified set of features
warning("Error in sentiment analysis: ", e$message)
cat("Falling back to basic sentiment features\n")
# Simple sentiment using just syuzhet's get_sentiment
simple_sentiment <- get_sentiment(texts)
# Return a data frame with just the simple sentiment
return(data.frame(sentiment = simple_sentiment))
})
}
# Extract features for train and dev sets
cat("Extracting sentiment and emotion features...\n")
train_features <- extract_features(train_aggregated$tweet)
dev_features <- extract_features(dev_aggregated$tweet)
# Convert quanteda DFM to a data frame (using either TF-IDF weighted or regular)
# Using TF-IDF weighted for better model performance
train_text_features <- convert(train_tfidf, to = "data.frame")
dev_text_features <- convert(dev_tfidf, to = "data.frame")
# Combine text features with sentiment/emotion features
train_combined <- cbind(train_text_features, train_features)
dev_combined <- cbind(dev_text_features, dev_features)
# Add target variable
